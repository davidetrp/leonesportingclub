# Credenziali API di Telegram: crea un'app su https://my.telegram.org → "API development tools"
TG_API_ID=123456
TG_API_HASH=0123456789abcdef0123456789abcdef

# Password per entrare nell'app dal telefono (obbligatoria se il server è raggiungibile da fuori casa)
APP_PASSWORD=cambiami

# Porta del server web
PORT=8080

# Qualità video richiesta a Telegram: 0 bassa, 1 media, 2 alta
STREAM_QUALITY=2

# 1 = canali di prova senza Telegram (per controllare che l'app funzioni)
DEMO=0

# Solo sul server online: il dominio del sito (es. tv.tuodominio.it oppure 5-75-1-20.sslip.io)
DOMAIN=
